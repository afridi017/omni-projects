# ─── Database (Neon / PostgreSQL) ───
# Required for all features — products, orders, admin settings.
# Example (Neon): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ─── Admin Panel ───
# Password to log in at /admin  (default: admin123 — CHANGE in production!)
# Strongly recommended: set this on Vercel, then change the password from
# Admin → Settings after first login (it is stored hashed in the DB).
ADMIN_PASSWORD=

# ─── Cloudinary (image uploads from admin panel) ───
# Required for the "Add Laptop" image upload and Settings image uploads.
# Paste a full Cloudinary URL  OR  set the three individual vars.
# Get these from your Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Public site URL (optional) ───
# Used in WhatsApp product links so customers get the full /shop link.
# Example: https://digital-laptop-peshawer.vercel.app
NEXT_PUBLIC_SITE_URL=
