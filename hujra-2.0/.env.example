# ============================================================
# HUJRA 2.0 — environment
# Everything optional. With zero keys the app runs in smooth
# DEMO mode (localStorage + BroadcastChannel multi-tab rooms).
# ============================================================

# ---- LiveKit (real WebRTC voice) ---------------------------
# Get free keys at https://cloud.livekit.io → Settings → Keys
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-subdomain.livekit.cloud

# ---- Supabase Realtime (rooms presence / state / reactions)-
# Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...